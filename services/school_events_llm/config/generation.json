{
  "schema_version": "1.0",
  "prompt_version": "0.1.0",
  "defaults": {
    "language": "ru",
    "variants_count": 1,
    "max_variants": 3,
    "max_concept_retries": 2,
    "allow_partial_result": true,
    "min_block_minutes": 2,
    "block_detail_mode": "per_block",
    "per_block_from_minutes": 60,
    "llm_quality_review": false,
    "max_repair_attempts_per_stage": 2,
    "provider_retry_attempts": 2,
    "provider_retry_backoff_seconds": [3, 10]
  },
  "script_length": {
    "base_chars": {
      "brief": 100,
      "standard": 250,
      "detailed": 400
    },
    "chars_per_minute": {
      "brief": 5,
      "standard": 12,
      "detailed": 20
    },
    "age_factor": {
      "1-4": 0.7
    },
    "short_warning_ratio": 0.9
  },
  "audience_award_min_voters_warning": 6,
  "reasoning_extra_output_tokens": 2000,
  "tasks": {
    "variation_plan": {
      "max_output_tokens": 3900,
      "max_output_tokens_per_variant": 1300,
      "temperature_hint": 0.65,
      "reasoning_effort": null
    },
    "scenario_plan": {
      "max_output_tokens": 3500,
      "temperature_hint": 0.4,
      "reasoning_effort": null
    },
    "scenario_blocks": {
      "max_output_tokens": 6000,
      "temperature_hint": 0.45,
      "reasoning_effort": null
    },
    "scenario_block": {
      "max_output_tokens": 4500,
      "temperature_hint": 0.45,
      "reasoning_effort": null
    },
    "materials": {
      "max_output_tokens": 4000,
      "temperature_hint": 0.4,
      "reasoning_effort": null
    },
    "quality_review": {
      "max_output_tokens": 1800,
      "temperature_hint": 0.1,
      "reasoning_effort": null
    }
  }
}